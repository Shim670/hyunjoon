int check(char board[][10], int result, int row, int col,int black, int count4) //5목이 완성되었는지 확인하는 함수
{
	char stone= board[row][col - 1];//현재값
	int count2;
	count2 = 1;
	for (int i = col; i <= 9&& board[row][i]==stone; i++)//가로 오른쪽
		count2++;	
	for (int j = col-2; j >= 0&& board[row][j]==stone; j--)//가로 왼쪽
		count2++;
	if (count2 >= 5 && black == 1 && count4 % 2 != 0)
		return 1;//black win
	else if (count2 >= 5 && black == 2 && count4 % 2 == 0)
		return 2; //white
	else if (count2 >= 5 && black == 1 && count4 % 2 == 0)
		return 5;//b
	else if (count2 >= 5 && black == 2 && count4 % 2 != 0)
		return 6;//w
	count2 = 1;
	for (int a = row + 1; a <= 10&& board[a][col-1]==stone; a++)//세로 위
		count2++;
	for (int b = row - 1; b >= 0&& board[b][col-1]==stone; b--)//세로 아래
		count2++;
	if (count2 >= 5 && black == 1 && count4 % 2 == 0)
		return 3; //w-> b
	else if (count2 >= 5 && black == 2 && count4 % 2 != 0)
		return 4; //white win
	else if (count2 >= 5 && black == 1 && count4 % 2 != 0)
		return 7;//b
	else if (count2 >= 5 && black == 2 && count4 % 2 == 0)
		return 8;//w
	int count3 = 1;
	//방금 놓은 돌을 기준으로 세기
	for (int i = 1; row + i <= 10 && col - 1 + i <= 9 && board[row + i][col - 1 + i] == stone; i++) // 왼쪽에서 오른쪽 대각선
		count3++;
	for (int j = 1; row - j >= 0 && col - 1 - j >= 0 && board[row - j][col - 1 - j] == stone; j++)// 오른쪽 아래에서 왼쪽 위 대각선
		count3++;

	if (count3>=5 && black == 1 && count4 % 2 == 0)
		return 9;// black
	else if (count3 >= 5 && black == 1 && count4 % 2 != 0)
		return 10; // black
	else if (count3 >= 5 && black == 2 && count4 % 2 == 0)
		return 11; //white
	else if (count3 >= 5 && black == 2 && count4 % 2 != 0)
		return 12; //white

	count3 = 1;
	for (int i = 1; row + i <= 10 && col - 1 - i >= 0 && board[row + i][col - 1 - i] == stone; i++)//오른쪽 위에서 왼쪽 아래 대각선(col은 작아지기)
		count3++;
	for (int j = 1; row - j >= 0 && col - 1 + j <= 9 && board[row - j][col - 1 + j] == stone; j++)// 
		count3++;
	if (count3 >= 5 && black == 1 && count4 % 2 == 0)
		return 13;// black
	else if (count3 >= 5 && black == 1 && count4 % 2 != 0)
		return 14; // black
	else if (count3 >= 5 && black == 2 && count4 % 2 == 0)
		return 15; //white
	else if (count3 >= 5 && black == 2 && count4 % 2 != 0)
		return 16; //white

	return 0;
}
